      pinned: true,

      backgroundColor: Colors.black,

      leading: Container(
        margin: const EdgeInsets.all(8),

        decoration: const BoxDecoration(
          color: Colors.white,
          shape: BoxShape.circle,
        ),

        child: IconButton(
          icon: const Icon(
            Icons.arrow_back,
            color: Colors.black,
          ),

          onPressed: () {
            Navigator.pop(context);
          },
        ),
      ),

      flexibleSpace: FlexibleSpaceBar(
        background: Stack(
          fit: StackFit.expand,

          children: [
            // IMAGE
            widget.imageUrl.isNotEmpty
                ? Image.network(
              widget.imageUrl,
              fit: BoxFit.cover,

              errorBuilder:
                  (context, error, stackTrace) {
                return Container(
                  color: Colors.grey.shade400,

                  child: const Icon(
                    Icons.image_not_supported,
                    size: 70,
                    color: Colors.white,
                  ),
                );
              },
            )
                : Container(
              color: Colors.grey.shade400,

              child: const Icon(
                Icons.image,
                size: 70,
                color: Colors.white,
              ),
            ),

            // DARK OVERLAY
            Container(
              decoration: BoxDecoration(
                gradient: LinearGradient(
                  begin: Alignment.topCenter,
                  end: Alignment.bottomCenter,

                  colors: [
                    Colors.black.withOpacity(.10),
                    Colors.black.withOpacity(.20),
                    Colors.black.withOpacity(.85),
                  ],
                ),
              ),
            ),

            // TEXT
            Positioned(
              left: 25,
              right: 25,
              bottom: 35,

              child: Column(
                crossAxisAlignment:
                CrossAxisAlignment.start,

                children: [
                  // CATEGORY
                  Container(
                    padding:
                    const EdgeInsets.symmetric(
                      horizontal: 12,
                      vertical: 6,
                    ),

                    decoration: BoxDecoration(
                      color: Colors.white,
                      borderRadius:
                      BorderRadius.circular(20),
                    ),

                    child: Text(
                      widget.category.isNotEmpty
                          ? widget.category
                          : "Destination",

                      style: const TextStyle(
                        color: Colors.black,
                        fontWeight:
                        FontWeight.bold,
                        fontSize: 12,
                      ),
                    ),
                  ),

                  const SizedBox(height: 12),

                  // TITLE
                  Text(
                    widget.title,
                    maxLines: 2,
                    overflow:
                    TextOverflow.ellipsis,

                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 34,
                      fontWeight:
                      FontWeight.bold,
                    ),
                  ),

                  const SizedBox(height: 8),

                  // CITY
                  Row(
                    children: [
                      const Icon(
                        Icons.location_on,
                        color: Colors.white,
                        size: 18,
                      ),

                      const SizedBox(width: 5),

                      Expanded(
                        child: Text(
                          widget.city,

                          style: const TextStyle(
                            color: Colors.white,
                            fontSize: 15,
                          ),
                        ),
                      ),
                    ],
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  // TITLE
  Widget _titleSection() {
    return Column(
      crossAxisAlignment:
      CrossAxisAlignment.start,

      children: [
        Text(
          widget.title,

          style: const TextStyle(
            fontSize: 30,
            fontWeight: FontWeight.bold,
            color: Colors.black,
          ),
        ),

        const SizedBox(height: 8),

        Row(
          children: [
            const Icon(
              Icons.location_on,
              size: 18,
              color: Colors.black,
            ),

            const SizedBox(width: 5),

            Expanded(
              child: Text(
                widget.location.isNotEmpty
                    ? widget.location
                    : widget.city,

                style: TextStyle(
                  color: Colors.grey.shade700,
                  fontSize: 15,
                ),
              ),
            ),
          ],
        ),
      ],
    );
  }

  // ACTION BUTTONS
  Widget _actionButtons() {
    return Wrap(
      spacing: 10,
      runSpacing: 10,

      children: [
        StreamBuilder<bool>(
          stream: isSaved(),

          builder: (context, snapshot) {
            final saved =
                snapshot.data ?? false;

            return _actionButton(
              icon: saved
                  ? Icons.bookmark
                  : Icons.bookmark_border,

              title:
              saved ? "Saved" : "Save",

              color: Colors.black,

              onTap: toggleSaved,
            );
          },
        ),

        _actionButton(
          icon: Icons.map_outlined,
          title: "Map",
          color: Colors.black,
          onTap: openMap,
        ),

        _actionButton(
          icon: Icons.hotel_outlined,
          title: "Lodge",
          color: Colors.black,
          onTap: openLodge,
        ),

        _actionButton(
          icon: Icons.restaurant_outlined,
          title: "Food",
          color: Colors.black,
          onTap: openFood,
        ),
      ],
    );
  }

  // ACTION BUTTON
  Widget _actionButton({
    required IconData icon,
    required String title,
    required Color color,
    required VoidCallback onTap,
  }) {
    return SizedBox(
      width: 125,

      child: ElevatedButton.icon(
        onPressed: onTap,

        icon: Icon(
          icon,
          size: 18,
        ),

        label: Text(title),

        style: ElevatedButton.styleFrom(
          backgroundColor: Colors.white,
          foregroundColor: color,

          elevation: 0,

          padding:
          const EdgeInsets.symmetric(
            vertical: 14,
          ),

          side: BorderSide(
            color: Colors.grey.shade400,
          ),

          shape:
          RoundedRectangleBorder(
            borderRadius:
            BorderRadius.circular(14),
          ),
        ),
      ),
    );
  }

  // LOCATION CARD
  Widget _locationCard() {
    return Container(
      width: double.infinity,

      padding: const EdgeInsets.all(20),

      decoration: BoxDecoration(
        color: Colors.white,

        borderRadius:
        BorderRadius.circular(20),

        border: Border.all(
          color: Colors.grey.shade300,
        ),
      ),

      child: Row(
        children: [
          Container(
            padding: const EdgeInsets.all(13),

            decoration: BoxDecoration(
              color: Colors.black,

              borderRadius:
              BorderRadius.circular(15),
            ),

            child: const Icon(
              Icons.location_on,
              color: Colors.white,
              size: 25,
            ),
          ),

          const SizedBox(width: 15),

          Expanded(
            child: Column(
              crossAxisAlignment:
              CrossAxisAlignment.start,

              children: [
                const Text(
                  "Location",

                  style: TextStyle(
                    fontWeight:
                    FontWeight.bold,
                    fontSize: 16,
                  ),
                ),

                const SizedBox(height: 5),

                Text(
                  widget.location.isNotEmpty
                      ? widget.location
                      : widget.city,

                  style: TextStyle(
                    color:
                    Colors.grey.shade700,
                    fontSize: 14,
                  ),
                ),
              ],
            ),
          ),

          IconButton(
            onPressed: openMap,

            icon: const Icon(
              Icons.open_in_new,
              color: Colors.black,
            ),
          ),
        ],
