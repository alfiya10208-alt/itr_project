  }

  // DESCRIPTION
  Widget _descriptionSection() {
    final text =
    widget.description.trim();

    return Column(
      crossAxisAlignment:
      CrossAxisAlignment.start,

      children: [
        const Text(
          "About this place",

          style: TextStyle(
            fontSize: 24,
            fontWeight: FontWeight.bold,
            color: Colors.black,
          ),
        ),

        const SizedBox(height: 12),

        Text(
          text.isNotEmpty
              ? text
              : "Discover the beauty and charm of "
              "${widget.title}. Explore this wonderful "
              "destination in ${widget.city}, Maharashtra "
              "and create unforgettable memories.",

          style: TextStyle(
            fontSize: 16,
            height: 1.7,
            color: Colors.grey.shade800,
          ),
        ),
      ],
    );
  }

  // INFORMATION
  Widget _infoSection() {
    return Column(
      crossAxisAlignment:
      CrossAxisAlignment.start,

      children: [
        const Text(
          "Destination Information",

          style: TextStyle(
            fontSize: 24,
            fontWeight: FontWeight.bold,
            color: Colors.black,
          ),
        ),

        const SizedBox(height: 15),

        Row(
          children: [
            Expanded(
              child: _infoCard(
                Icons.location_city,
                "City",
                widget.city,
              ),
            ),

            const SizedBox(width: 12),

            Expanded(
              child: _infoCard(
                Icons.category_outlined,
                "Category",

                widget.category.isNotEmpty
